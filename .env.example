# ────────────────────────────────────────────────────────────────────
# Email Worker (Cloudflare Email Worker — receives mail for *@privatimail.com)
# Reuse the same instance as the Notion/Todoist onboarding projects.
# Source: https://github.com/ansgareutychisO/cloudflare-email-worker
# ────────────────────────────────────────────────────────────────────
EMAIL_WORKER_BASE_URL=https://mail-api.privatimail.com
EMAIL_WORKER_TOKEN=<your-query-api-token>

# ────────────────────────────────────────────────────────────────────
# Bridge daemon (the Python WebSocket server that the Chrome extension
# connects to). Only needed for `signup-ext` / `run-full-ext` commands.
# ────────────────────────────────────────────────────────────────────
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
# Auth token for the extension (empty = no auth in dev mode)
BRIDGE_AUTH_TOKEN=

# ────────────────────────────────────────────────────────────────────
# Supabase signup defaults
# ────────────────────────────────────────────────────────────────────
# Email domain for new accounts (must be received by the email worker)
SUPABASE_SIGNUP_EMAIL_DOMAIN=privatimail.com
# Default password for new accounts (must meet Supabase's strength check)
SUPABASE_SIGNUP_DEFAULT_PASSWORD=

# ────────────────────────────────────────────────────────────────────
# Existing account (operate without signup)
# ────────────────────────────────────────────────────────────────────
# Either the short-lived JWT access_token (from verify redirect) OR a
# long-lived PAT (sbp_...) from /platform/profile/access-tokens.
# PAT is preferred — JWT expires in 30 minutes.
SUPABASE_ACCESS_TOKEN=
